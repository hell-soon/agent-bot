#!/bin/bash
# gh от имени бота: свежий токен на каждый вызов (токен GitHub App живёт 1 час)
BOT_DIR=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
REAL_GH=$(PATH=$(printf '%s' "$PATH" | tr ':' '\n' | grep -vx "$BOT_DIR/bin" | paste -sd: -) command -v gh)
[ -n "$REAL_GH" ] || { echo "gh не найден: brew install gh" >&2; exit 127; }
GH_TOKEN="$("$BOT_DIR/token.sh")" exec "$REAL_GH" "$@"
